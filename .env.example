# ============================================
# GitHub Container Registry
# ============================================
GITHUB_REPOSITORY_OWNER=your-github-username

# ============================================
# Domain Configuration
# ============================================
# For local development, use: localhost
# For production, use your actual domain: yourdomain.com
DOMAIN=localhost

# ============================================
# AiCredits API Configuration
# Get your API key from https://aicredits.in
# ============================================

# Required: Your AiCredits API key
AICREDITS_API_KEY=your_api_key_here

# Optional: API base URL (default: api.aicredits.in)
AICREDITS_BASE_URL=api.aicredits.in

# Optional: Model to use for text generation (default: gpt-4o-mini)
# Available models: gpt-4o-mini, gpt-4, gpt-3.5-turbo, etc.
AICREDITS_MODEL=gpt-4o-mini

# Optional: Model to use for text embeddings (default: text-embedding-3-small)
# Available models: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002, etc.
AICREDITS_EMBEDDING_MODEL=text-embedding-3-small
