{
    # Disable automatic HTTPS when behind external reverse proxy
    auto_https off
}

# Production configuration - HTTP only (external Caddy handles HTTPS)
:80 {
    # API routes - proxy to backend
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy localhost:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            
            # Health check
            health_uri /status
            health_interval 30s
            health_timeout 10s
        }
    }

    # Frontend - serve static files with SPA fallback
    handle {
        root * /srv
        encode gzip zstd
        try_files {path} /index.html
        file_server
    }

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Logging
    log {
        output file /app/data/access.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }
}

